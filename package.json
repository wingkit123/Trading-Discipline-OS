{
  "name": "trading-discipline-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first XAUUSD trading journal and SOP discipline coach",
  "engines": { "node": ">=22.5.0" },
  "scripts": {
    "dev": "concurrently -n api,web \"cross-env PORT=4174 tsx watch server/index.ts\" \"vite --host 127.0.0.1 --port 5173\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "node dist/server/server/index.js",
    "test": "tsx --test server/tests/*.test.ts"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
